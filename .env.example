# IxMaOperations Environment Configuration Template

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — sends the request-flow email (app/api/request/route.ts) to OWNER_EMAIL
RESEND_API_KEY="re_your_resend_api_key"

# Inbox that receives package + custom project requests
OWNER_EMAIL="you@example.com"

# --- Client portal e-mails (lib/portal/notify.ts) ---
# Where the portal's alerts and the weekday-morning digest go. Optional: defaults to OWNER_EMAIL.
# A plus-address ("you+portal@gmail.com") lets a mail filter file them out of your main inbox:
# every alert has the subject tag "[Portal" and a "List-Id: IxMa Portal alerts <portal-alerts.<site host>>" header.
OWNER_ALERT_EMAIL=""
# The "from" of portal e-mails, e.g. "IxMa Operations <portal@ixmaoperations.com>". It MUST be on a
# domain verified in Resend (Domains -> Add domain -> add the DNS records). Without it the sandbox sender
# is used, which only delivers to your own Resend address: you will get your alerts, clients will not get theirs.
PORTAL_EMAIL_FROM=""

# Calendly booking link, embedded on /custom-projects (public — no secret).
# Used for every locale unless NEXT_PUBLIC_CALENDLY_URL_ES is also set.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/emilio-a-ramirezl"

# Optional: a second Calendly event type whose "invitee language" (Calendly
# dashboard: Scheduling -> event type -> "..." -> Change invitee language)
# is set to Spanish. Calendly has no URL parameter for this — the display
# language is a per-event-type setting on Calendly's side, not something
# this app can force at request time — so a Spanish-language embed needs
# its own event type/link. Shown to ES-locale visitors on /custom-projects
# when set; falls back to NEXT_PUBLIC_CALENDLY_URL (English) when unset.
NEXT_PUBLIC_CALENDLY_URL_ES=""

# --- Native scheduler + private client portal (CLIENT_PORTAL_AND_SCHEDULER_PLAN.md) ---
# Not used yet; listed so the CSP in next.config.mjs and the plan stay in sync.

# Supabase (portal auth + database). NEXT_PUBLIC_SUPABASE_URL is also read by
# next.config.mjs to allow-list the origin in the CSP. Dashboard setup: turn
# OFF "Allow new users to sign up" — accounts are created by the owner only.
NEXT_PUBLIC_SUPABASE_URL=""
# Publishable key (sb_publishable_...) — safe for the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_...) — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never import into a client component.
SUPABASE_SECRET_KEY=""

# AES-256 key (32 random bytes, base64) that encrypts guest name/email/notes/address
# before they are written to Supabase (lib/field-crypto.ts). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP and set the same value in Vercel — if lost, those fields can't be recovered.
DATA_ENCRYPTION_KEY=""

# Google Calendar (host side only; OAuth refresh token for the owner's account.
# Publish the OAuth consent screen to "In production" or the refresh token
# expires after 7 days).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
# Secondary calendar for per-date overrides — create "IxMa Availability" in Google
# Calendar, copy its Calendar ID (Settings -> Integrate calendar). All-day events titled
# IN-PERSON (claim the day for on-site work), ONLINE-ONLY or OFF (block the day) change what
# /book offers. Leave empty = no overrides; in-person is then first come, first served.
GOOGLE_AVAILABILITY_CALENDAR_ID=""
# Shared secret for the daily on-site digest (vercel.json cron -> /api/cron/onsite-digest).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. Unset = the route refuses everything.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# Two-step verification is REQUIRED of the owner (the owner's account can see every client's data). Leave this unset.
# Setting it to false is an emergency door only (for example if no one can set up an authenticator app): remove it again afterwards.
# PORTAL_REQUIRE_OWNER_2FA=true
# IANA timezone the working hours are expressed in (lib/availability-config.ts).
HOST_TIMEZONE="America/Mexico_City"

# Upstash Redis — backs per-IP rate limiting on /api/examples/scrape and
# /api/request (lib/rate-limit.ts). Optional: if unset, those routes run
# with NO rate limiting rather than failing (see lib/rate-limit.ts's file
# header) — fine for local dev, not recommended for production.
# Free tier: https://console.upstash.com -> Create Database -> REST API section.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"
