# IxMaOperations Environment Configuration Template

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — sends the request-flow email (app/api/request/route.ts) to OWNER_EMAIL
RESEND_API_KEY="re_your_resend_api_key"

# Inbox that receives package + custom project requests
OWNER_EMAIL="you@example.com"

# Calendly booking link, embedded on /custom-projects (public — no secret)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/emilio-a-ramirezl"

# Upstash Redis — backs per-IP rate limiting on /api/examples/scrape and
# /api/request (lib/rate-limit.ts). Optional: if unset, those routes run
# with NO rate limiting rather than failing (see lib/rate-limit.ts's file
# header) — fine for local dev, not recommended for production.
# Free tier: https://console.upstash.com -> Create Database -> REST API section.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"
